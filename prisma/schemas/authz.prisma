enum RoleType {
  ADMIN
  CLIENT
  RECEPTIONIST
  SALES_SUPPORT
}

model User {
  id                  String        @id @db.Uuid
  email               String?       @unique
  name                String
  phone               String        @unique
  paymentNumber       String?
  paymentInstructions String        @default("No online payments. Pay in person at the salon or directly to the owner's official number.")
  avatarUrl           String?
  bio                 String?
  passwordHash        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  roles               UserRole[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @db.Uuid
  role       RoleType
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}   